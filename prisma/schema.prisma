// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MULTI-TENANT ARCHITECTURE
// ============================================

enum UserRole {
  SUPER_ADMIN    // Platform administrator
  TENANT_ADMIN   // Organization/Company owner
  MANAGER        // Parking lot manager
  STAFF          // Parking attendant
  USER           // Regular user/customer
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum SubscriptionPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  CASH
  BANK_TRANSFER
  PAYPAL
  STRIPE
}

enum SpotStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  DISABLED
}

enum SpotType {
  STANDARD
  COMPACT
  ELECTRIC
  HANDICAPPED
  MOTORCYCLE
  OVERSIZED
}

enum VehicleType {
  CAR
  MOTORCYCLE
  TRUCK
  VAN
  SUV
  ELECTRIC
  BICYCLE
}

enum MembershipType {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum PriceType {
  PER_MINUTE
  PER_HOUR
  PER_DAY
  FLAT_RATE
}

// ============================================
// TENANT (Organization/Company)
// ============================================

model Tenant {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique // URL-friendly identifier
  email           String
  phone           String?
  address         String?
  logo            String?
  website         String?

  // Subscription
  plan            SubscriptionPlan @default(FREE)
  status          TenantStatus     @default(TRIAL)
  trialEndsAt     DateTime?
  subscriptionEndsAt DateTime?

  // Limits based on plan
  maxParkingLots  Int              @default(1)
  maxSpots        Int              @default(10)
  maxUsers        Int              @default(3)

  // Billing
  stripeCustomerId String?         @unique

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  users           User[]
  parkingLots     ParkingLot[]
  bookings        Booking[]
  payments        Payment[]
  subscriptions   Subscription[]

  @@index([slug])
  @@index([status])
}

// ============================================
// USER
// ============================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  password        String    // Hashed with bcrypt
  name            String?
  phone           String?
  avatar          String?

  // Multi-tenant
  tenantId        String?
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  role            UserRole  @default(USER)

  // User preferences
  defaultVehicleId String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?

  // Relations
  accounts        Account[]
  sessions        Session[]
  vehicles        Vehicle[]
  bookings        Booking[]
  payments        Payment[]
  activityLogs    ActivityLog[]
  memberships     Membership[]
  parkingSessions ParkingSession[]
  invoices        Invoice[]

  @@index([email])
  @@index([tenantId])
  @@index([role])
}

// ============================================
// AUTHENTICATION (NextAuth.js)
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// PARKING LOT
// ============================================

model ParkingLot {
  id              String      @id @default(cuid())
  name            String
  description     String?     @db.Text

  // Location
  address         String
  city            String
  state           String
  country         String
  zipCode         String?
  latitude        Float?
  longitude       Float?

  // Multi-tenant
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Operating hours
  opensAt         String?     // Format: "08:00"
  closesAt        String?     // Format: "22:00"
  is24Hours       Boolean     @default(false)

  // Capacity
  totalSpots      Int
  availableSpots  Int

  // Pricing (per hour in cents)
  basePrice       Int         @default(500) // $5.00

  // Features
  hasSecurity     Boolean     @default(false)
  hasCCTV         Boolean     @default(false)
  hasCoveredParking Boolean   @default(false)
  hasEvCharging   Boolean     @default(false)
  hasWifi         Boolean     @default(false)

  status          String      @default("active") // active, inactive, maintenance

  images          String[]    // Array of image URLs

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  parkingSpots    ParkingSpot[]
  bookings        Booking[]
  priceConfigs    PriceConfiguration[]
  memberships     Membership[]
  parkingSessions ParkingSession[]
  invoices        Invoice[]

  @@index([tenantId])
  @@index([city])
  @@index([status])
}

// ============================================
// PARKING SPOT
// ============================================

model ParkingSpot {
  id              String      @id @default(cuid())
  spotNumber      String      // e.g., "A-101", "B-25"
  floor           String?     // e.g., "1", "2", "B1" (basement)
  section         String?     // e.g., "A", "B", "North"

  parkingLotId    String
  parkingLot      ParkingLot  @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)

  type            SpotType    @default(STANDARD)
  status          SpotStatus  @default(AVAILABLE)

  // Pricing override (if different from lot base price)
  pricePerHour    Int?        // in cents

  // Dimensions
  width           Float?      // in meters
  length          Float?      // in meters

  // Features
  hasEvCharger    Boolean     @default(false)
  isCovered       Boolean     @default(false)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  bookings         Booking[]
  parkingSessions  ParkingSession[]
  sessionsAssigned ParkingSession[] @relation("SessionSpots")

  @@unique([parkingLotId, spotNumber])
  @@index([parkingLotId])
  @@index([status])
}

// ============================================
// VEHICLE
// ============================================

model Vehicle {
  id              String      @id @default(cuid())
  licensePlate    String
  make            String?     // e.g., "Toyota"
  model           String?     // e.g., "Camry"
  color           String?
  year            Int?
  type            VehicleType @default(CAR)

  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  isDefault       Boolean     @default(false)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  bookings        Booking[]
  parkingSessions ParkingSession[]

  @@index([userId])
  @@index([licensePlate])
}

// ============================================
// BOOKING
// ============================================

model Booking {
  id              String        @id @default(cuid())
  bookingNumber   String        @unique // e.g., "BK-2024-001234"

  // Multi-tenant
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  parkingLotId    String
  parkingLot      ParkingLot    @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)

  parkingSpotId   String?
  parkingSpot     ParkingSpot?  @relation(fields: [parkingSpotId], references: [id], onDelete: SetNull)

  vehicleId       String
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  // Timing
  startTime       DateTime
  endTime         DateTime
  actualStartTime DateTime?
  actualEndTime   DateTime?

  // Pricing
  pricePerHour    Int           // in cents (saved at booking time)
  estimatedCost   Int           // in cents
  actualCost      Int?          // in cents (calculated after checkout)

  status          BookingStatus @default(PENDING)

  // Notes
  notes           String?       @db.Text

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  payment         Payment?

  @@index([tenantId])
  @@index([userId])
  @@index([parkingLotId])
  @@index([status])
  @@index([startTime])
  @@index([bookingNumber])
}

// ============================================
// PAYMENT
// ============================================

model Payment {
  id              String        @id @default(cuid())
  paymentNumber   String        @unique // e.g., "PAY-2024-001234"

  // Multi-tenant
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookingId       String        @unique
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amount          Int           // in cents
  currency        String        @default("USD")

  method          PaymentMethod
  status          PaymentStatus @default(PENDING)

  // External payment provider
  stripePaymentId String?
  stripeInvoiceId String?

  // Card details (last 4 digits only)
  cardLast4       String?
  cardBrand       String?

  paidAt          DateTime?
  refundedAt      DateTime?
  refundAmount    Int?          // in cents

  // Metadata
  metadata        Json?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([paymentNumber])
}

// ============================================
// SUBSCRIPTION (for tenant billing)
// ============================================

model Subscription {
  id                    String           @id @default(cuid())

  tenantId              String
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  plan                  SubscriptionPlan
  status                String           // active, cancelled, past_due

  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean          @default(false)

  // Stripe
  stripeSubscriptionId  String?          @unique
  stripePriceId         String?

  // Pricing
  amount                Int              // in cents
  currency              String           @default("USD")
  interval              String           // month, year

  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  cancelledAt           DateTime?

  @@index([tenantId])
  @@index([status])
}

// ============================================
// ACTIVITY LOG (Audit trail)
// ============================================

model ActivityLog {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  action      String   // e.g., "booking.created", "user.login"
  entity      String?  // e.g., "Booking", "Payment"
  entityId    String?

  ipAddress   String?
  userAgent   String?

  metadata    Json?    // Additional context

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// PRICE CONFIGURATION (Flexible pricing)
// ============================================

model PriceConfiguration {
  id              String      @id @default(cuid())
  name            String      // e.g., "Weekend Rate", "Night Rate"

  parkingLotId    String
  parkingLot      ParkingLot  @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)

  priceType       PriceType   @default(PER_HOUR)

  // Pricing
  pricePerMinute  Int?        // in cents
  pricePerHour    Int?        // in cents
  pricePerDay     Int?        // in cents
  flatRate        Int?        // in cents

  // Time-based rules (optional)
  startTime       String?     // Format: "08:00"
  endTime         String?     // Format: "18:00"
  daysOfWeek      Int[]       // 0=Sunday, 1=Monday, etc.

  isActive        Boolean     @default(true)
  priority        Int         @default(0) // Higher priority overrides

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([parkingLotId])
  @@index([isActive])
}

// ============================================
// MEMBERSHIP (Hora, Día, Semana, Mes)
// ============================================

model Membership {
  id              String           @id @default(cuid())
  membershipNumber String          @unique // e.g., "MEM-2024-001234"

  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  parkingLotId    String
  parkingLot      ParkingLot       @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)

  type            MembershipType   // HOURLY, DAILY, WEEKLY, MONTHLY, YEARLY
  status          MembershipStatus @default(ACTIVE)

  // Validity period
  startDate       DateTime
  endDate         DateTime

  // Pricing
  price           Int              // in cents (total paid for membership)

  // Benefits
  unlimitedAccess Boolean          @default(true)
  maxHoursPerDay  Int?             // NULL = unlimited
  maxEntriesPerDay Int?            // NULL = unlimited

  // Assigned vehicle (optional - can be for specific plate)
  allowedVehicles String[]         // Array of license plates

  // Payment
  isPaid          Boolean          @default(false)
  paidAt          DateTime?

  // Auto-renewal
  autoRenew       Boolean          @default(false)
  renewalDate     DateTime?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  parkingSessions ParkingSession[]

  @@index([userId])
  @@index([parkingLotId])
  @@index([status])
  @@index([endDate])
  @@index([membershipNumber])
}

// ============================================
// PARKING SESSION (Control Entrada/Salida)
// ============================================

model ParkingSession {
  id              String        @id @default(cuid())
  sessionNumber   String        @unique // e.g., "SES-2024-001234"

  // Vehicle identification
  vehicleId       String
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  licensePlate    String        // Denormalized for quick lookup

  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  parkingLotId    String
  parkingLot      ParkingLot    @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)

  parkingSpotId   String?
  parkingSpot     ParkingSpot?  @relation(fields: [parkingSpotId], references: [id], onDelete: SetNull)

  // Membership (if applicable)
  membershipId    String?
  membership      Membership?   @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  // Entry/Exit tracking
  entryTime       DateTime      @default(now())
  exitTime        DateTime?

  // Duration in minutes (calculated on exit)
  durationMinutes Int?

  status          SessionStatus @default(IN_PROGRESS)

  // Pricing applied
  pricePerMinute  Int?          // in cents (snapshot at entry)
  pricePerHour    Int?          // in cents (snapshot at entry)

  // Total cost
  totalCost       Int?          // in cents (calculated on exit)

  // Payment tracking
  isPaid          Boolean       @default(false)
  paidAt          DateTime?
  paymentMethod   PaymentMethod?

  // Staff who processed entry/exit
  entryStaffId    String?       // User ID of staff
  exitStaffId     String?       // User ID of staff

  // Notes
  entryNotes      String?       @db.Text
  exitNotes       String?       @db.Text

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  invoice         Invoice?
  assignedSpots   ParkingSpot[] @relation("SessionSpots")

  @@index([vehicleId])
  @@index([userId])
  @@index([parkingLotId])
  @@index([licensePlate])
  @@index([status])
  @@index([entryTime])
  @@index([exitTime])
  @@index([sessionNumber])
}

// ============================================
// INVOICE (Facturación detallada)
// ============================================

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique // e.g., "INV-2024-001234"

  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  parkingLotId    String
  parkingLot      ParkingLot    @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)

  // Related session
  parkingSessionId String?      @unique
  parkingSession   ParkingSession? @relation(fields: [parkingSessionId], references: [id], onDelete: SetNull)

  // Invoice details
  issueDate       DateTime      @default(now())
  dueDate         DateTime      // When payment is due

  // Line items (stored as JSON for flexibility)
  lineItems       Json          // [{ description, quantity, unitPrice, total }]

  // Amounts
  subtotal        Int           // in cents
  tax             Int           @default(0) // in cents
  discount        Int           @default(0) // in cents
  total           Int           // in cents

  // Payment tracking
  status          InvoiceStatus @default(ISSUED)
  paidAmount      Int           @default(0) // in cents
  balance         Int           // in cents (total - paidAmount)

  paidAt          DateTime?
  paymentMethod   PaymentMethod?

  // Debt tracking
  isOverdue       Boolean       @default(false)
  overdueDate     DateTime?

  // Late fees
  lateFee         Int           @default(0) // in cents
  lateFeeApplied  Boolean       @default(false)

  // Notes
  notes           String?       @db.Text
  internalNotes   String?       @db.Text // Only visible to staff

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([parkingLotId])
  @@index([status])
  @@index([dueDate])
  @@index([isOverdue])
  @@index([invoiceNumber])
}
